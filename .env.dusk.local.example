# Konfiguration für die Dusk-Browsertests (spec.md 7).
# Kopie unter .env.dusk.local anlegen – die Datei ist bewusst nicht im Repo,
# weil sie lokale Zugangsdaten enthält.
#
# Wichtig: Dusk leert diese Datenbank bei jedem Lauf. Niemals auf die
# Entwicklungsdatenbank zeigen lassen.

APP_ENV=local
APP_DEBUG=true
APP_KEY=
APP_URL=http://127.0.0.1:8000

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pokemon_database_dusk
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync
MAIL_MAILER=log

# Nur nötig, wenn kein Chrome installiert ist: Pfad zu einer portablen
# "Chrome for Testing"-Version (https://googlechromelabs.github.io/chrome-for-testing/).
# Unter Windows Schraegstriche verwenden - dotenv deutet Backslashes als Escape.
# DUSK_CHROME_BINARY=C:/pfad/zu/chrome.exe
