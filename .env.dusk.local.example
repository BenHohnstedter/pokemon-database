# Konfiguration für die Dusk-Browsertests (spec.md 7).
# Kopie unter .env.dusk.local anlegen – die Datei ist bewusst nicht im Repo,
# weil sie lokale Zugangsdaten enthält.
#
# Wichtig: Dusk leert diese Datenbank bei jedem Lauf. Niemals auf die
# Entwicklungsdatenbank zeigen lassen.

APP_ENV=local
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pokemon_database_dusk
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync
MAIL_MAILER=log
